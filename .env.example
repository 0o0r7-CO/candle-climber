# Candle Climber — environment template
# Copy to .env.local and fill values when the corresponding phase ships.
# Never commit real secrets.

# Phase p1 — global leaderboard persistence
# Option A (recommended): MongoDB Atlas M0 free tier ($50 credit via GitHub Student Pack)
# Option B: Supabase free tier (Postgres + realtime)
# Behavior: if DATABASE_URL is a mongodb:// or mongodb+srv:// URI, the leaderboard
# automatically uses MongoDB (db: candleclimber, coll: scores). Otherwise it runs
# in-memory (resets on restart). No code changes needed either way.
# DATABASE_URL=

# Phase p2 — wallet connect (Reown / WalletConnect Cloud free tier)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Phase p2 — stock market data proxy (Yahoo Finance public endpoint, no key)
# No config required.

# Phase p3+ — Robinhood Chain testnet (public RPC + faucet, no key)
# NEXT_PUBLIC_CHAIN_RPC_URL=
